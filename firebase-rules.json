{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth.uid === $uid"
      }
    },
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid)",
        "players": { "$uid": { ".write": "auth.uid === $uid" } },
        "input":   { "$uid": { ".write": "auth.uid === $uid" } }
      }
    }
  }
}
